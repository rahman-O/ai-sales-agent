  payloadData                   Json              @default("{}") @map("payload_data")
  outboundMessageId             String?           @map("outbound_message_id") @db.Uuid
  processingOwner               String?           @map("processing_owner")
  processingStartedAt           DateTime?         @map("processing_started_at") @db.Timestamptz(6)
  leaseUntil                    DateTime?         @map("lease_until") @db.Timestamptz(6)
  executedAt                    DateTime?         @map("executed_at") @db.Timestamptz(6)
  cancelledAt                   DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  suppressedAt                  DateTime?         @map("suppressed_at") @db.Timestamptz(6)
  resultReasonCode              String?           @map("result_reason_code")
  createdByType                 String            @map("created_by_type")
  createdByUserId               String?           @map("created_by_user_id") @db.Uuid
  createdByAgentRunId           String?           @map("created_by_agent_run_id") @db.Uuid
  createdAt                     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization                  Organization      @relation(fields: [organizationId], references: [id])
  customer                      Customer          @relation(fields: [organizationId, customerId], references: [organizationId, id])
  lead                          Lead?             @relation(fields: [organizationId, leadId], references: [organizationId, id])
