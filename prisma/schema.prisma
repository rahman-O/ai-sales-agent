generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/client"
}

datasource db {
  provider = "postgresql"
}

/// Global identity. authSubject maps to verified JWT `sub` (immutable external id).
model User {
  id          String               @id @default(uuid()) @db.Uuid
  authSubject String               @unique @map("auth_subject")
  displayName String?              @map("display_name")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships OrganizationMember[]
  auditLogs   AuditLog[]           @relation("AuditActor")
  idempotency IdempotencyRecord[]

  @@map("users")
}

model Organization {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  members            OrganizationMember[]
  auditLogs          AuditLog[]
  outbox             OutboxEvent[]
  customers          Customer[]
  locations          Location[]
  services           Service[]
  staffMembers       StaffMember[]
  channelConnections ChannelConnection[]
  conversations      Conversation[]
  messages           Message[]
  webhookReceipts    WebhookReceipt[]
  consumerReceipts   ConsumerReceipt[]
  outboundAttempts   OutboundAttempt[]
  agentConfigs       AgentConfig[]
  agentRuns          AgentRun[]
  toolCalls          ToolCall[]
  commandOperations  CommandOperation[]
  usageEvents        UsageEvent[]
  conversationSummaries ConversationSummary[]
  knowledgeDocuments    KnowledgeDocument[]
  knowledgeVersions     KnowledgeDocumentVersion[]
  knowledgeChunks       KnowledgeChunk[]
  leads                 Lead[]
  leadActivities        LeadActivity[]
  staffAvailabilityRules StaffAvailabilityRule[]
  staffAvailabilityExceptions StaffAvailabilityException[]
  bookings              Booking[]
  bookingActivities     BookingActivity[]
  messageTemplates      MessageTemplate[]
  messageTemplateVersions MessageTemplateVersion[]
  followUpPolicy        OrganizationFollowUpPolicy?
  followUps             FollowUp[]

  @@map("organizations")
}

model Customer {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  displayName     String?            @map("display_name")
  preferredLocale String?            @map("preferred_locale")
  version         Int                @default(1)
  archivedAt      DateTime?          @map("archived_at") @db.Timestamptz(6)
  mergedIntoId    String?            @map("merged_into_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization       @relation(fields: [organizationId], references: [id])
  identities      CustomerIdentity[]
  conversations   Conversation[]
  leads           Lead[]
  bookings        Booking[]
  followUps       FollowUp[]

  @@unique([organizationId, id])
  @@index([organizationId, updatedAt, id])
  @@map("customers")
}

model ChannelConnection {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  provider           String
  externalChannelId  String             @map("external_channel_id")
  status             String             @default("ACTIVE")
  credentialRef      String?            @map("credential_ref")
  policyJson         Json?              @map("policy_json")
  displayPhoneNumber String?            @map("display_phone_number")
  wabaId             String?            @map("waba_id")
  lastVerifiedAt     DateTime?          @map("last_verified_at") @db.Timestamptz(6)
  healthStatus       String             @default("ACTIVE") @map("health_status")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization       Organization       @relation(fields: [organizationId], references: [id])
  identities         CustomerIdentity[]
  conversations      Conversation[]
  messages           Message[]
  webhookReceipts    WebhookReceipt[]
  followUps          FollowUp[]

  @@unique([provider, externalChannelId])
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@map("channel_connections")
}

model CustomerIdentity {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  customerId         String            @map("customer_id") @db.Uuid
  channelConnectionId String           @map("channel_connection_id") @db.Uuid
  channel            String
  externalAddress    String            @map("external_address")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt          DateTime?         @map("revoked_at") @db.Timestamptz(6)
  customer           Customer          @relation(fields: [organizationId, customerId], references: [organizationId, id])
  channelConnection  ChannelConnection @relation(fields: [organizationId, channelConnectionId], references: [organizationId, id])
  conversations      Conversation[]

  @@unique([organizationId, channelConnectionId, externalAddress])
  @@unique([organizationId, id])
  @@index([organizationId, customerId])
  @@map("customer_identities")
}

model Location {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  name           String
  timezone       String
  address        String?
  active         Boolean       @default(true)
  version        Int           @default(1)
  archivedAt     DateTime?     @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization  @relation(fields: [organizationId], references: [id])
  services       Service[]
  staffMembers   StaffMember[]
  leads          Lead[]
  availabilityRules StaffAvailabilityRule[]
  availabilityExceptions StaffAvailabilityException[]
  bookings       Booking[]

  @@unique([organizationId, id])
  @@index([organizationId, active])
  @@map("locations")
}

model Service {
  id                  String         @id @default(uuid()) @db.Uuid
  organizationId      String         @map("organization_id") @db.Uuid
  locationId          String         @map("location_id") @db.Uuid
  name                String
  durationMinutes     Int            @map("duration_minutes")
  bufferBeforeMinutes Int            @default(0) @map("buffer_before_minutes")
  bufferAfterMinutes  Int            @default(0) @map("buffer_after_minutes")
  amountMinor         BigInt         @map("amount_minor")
  currency            String         @db.Char(3)
  pricingVersion      Int            @default(1) @map("pricing_version")
  bookingEnabled      Boolean        @default(true) @map("booking_enabled")
  minimumLeadMinutes  Int            @default(60) @map("minimum_lead_minutes")
  maximumAdvanceDays  Int            @default(30) @map("maximum_advance_days")
  active              Boolean        @default(true)
  version             Int            @default(1)
  archivedAt          DateTime?      @map("archived_at") @db.Timestamptz(6)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization        Organization   @relation(fields: [organizationId], references: [id])
  location            Location       @relation(fields: [organizationId, locationId], references: [organizationId, id])
  staff               ServiceStaff[]
  leads               Lead[]
  bookings            Booking[]

  @@unique([organizationId, id])
  @@index([organizationId, active, name])
  @@map("services")
}

model StaffMember {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  locationId     String         @map("location_id") @db.Uuid
  memberUserId   String?        @map("member_user_id") @db.Uuid
  displayName    String         @map("display_name")
  active         Boolean        @default(true)
  version        Int            @default(1)
  archivedAt     DateTime?      @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization   @relation(fields: [organizationId], references: [id])
  location       Location       @relation(fields: [organizationId, locationId], references: [organizationId, id])
  services       ServiceStaff[]
  availabilityRules StaffAvailabilityRule[]
  availabilityExceptions StaffAvailabilityException[]
  bookings       Booking[]

  @@unique([organizationId, id])
  @@index([organizationId, locationId, active])
  @@map("staff_members")
}

model ServiceStaff {
  organizationId String      @map("organization_id") @db.Uuid
  serviceId      String      @map("service_id") @db.Uuid
  staffId        String      @map("staff_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  service        Service     @relation(fields: [organizationId, serviceId], references: [organizationId, id])
  staff          StaffMember @relation(fields: [organizationId, staffId], references: [organizationId, id])

  @@id([organizationId, serviceId, staffId])
  @@index([organizationId, staffId])
  @@map("service_staff")
}

model Conversation {
  id                       String            @id @default(uuid()) @db.Uuid
  organizationId           String            @map("organization_id") @db.Uuid
  customerId               String            @map("customer_id") @db.Uuid
  channelConnectionId      String            @map("channel_connection_id") @db.Uuid
  identityId               String            @map("identity_id") @db.Uuid
  mode                     String            @default("AI_ACTIVE")
  /// Stores organization_members.user_id (despite column name).
  ownerMemberId            String?           @map("owner_member_id") @db.Uuid
  ownershipEpoch           Int               @default(0) @map("ownership_epoch")
  nextSequence             Int               @default(1) @map("next_sequence")
  processedSequence        Int               @default(0) @map("processed_sequence")
  nextTimelineSequence     Int               @default(1) @map("next_timeline_sequence")
  /// Inbound at or below this ingress must not start autonomous AgentRuns after resume.
  aiEligibleAfterSequence  Int               @default(0) @map("ai_eligible_after_sequence")
  pausedAt                 DateTime?         @map("paused_at") @db.Timestamptz(6)
  pauseReasonCode          String?           @map("pause_reason_code")
  pauseReasonText          String?           @map("pause_reason_text")
  resumedAt                DateTime?         @map("resumed_at") @db.Timestamptz(6)
  leaseOwner               String?           @map("lease_owner")
  leaseFence               Int               @default(0) @map("lease_fence")
  leaseExpiresAt           DateTime?         @map("lease_expires_at") @db.Timestamptz(6)
  version                  Int               @default(1)
  lastMessageAt            DateTime?         @map("last_message_at") @db.Timestamptz(6)
  providerEventWatermarkAt DateTime?         @map("provider_event_watermark_at") @db.Timestamptz(6)
  lastCustomerInboundAt    DateTime?         @map("last_customer_inbound_at") @db.Timestamptz(6)
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization             Organization      @relation(fields: [organizationId], references: [id])
  customer                 Customer          @relation(fields: [organizationId, customerId], references: [organizationId, id])
  channelConnection        ChannelConnection @relation(fields: [organizationId, channelConnectionId], references: [organizationId, id])
  identity                 CustomerIdentity  @relation(fields: [organizationId, identityId], references: [organizationId, id])
  ownerMember              OrganizationMember? @relation("ConversationOwner", fields: [organizationId, ownerMemberId], references: [organizationId, userId])
  messages                 Message[]
  agentRuns                AgentRun[]
  conversationSummaries    ConversationSummary[]
  sourceLeads              Lead[]           @relation("LeadSourceConversation")
  sourceLeadActivities     LeadActivity[]   @relation("LeadActivitySourceConversation")
  sourceBookings           Booking[]        @relation("BookingSourceConversation")
  followUps                FollowUp[]

  @@unique([organizationId, channelConnectionId, identityId])
  @@unique([organizationId, id])
  @@index([organizationId, mode, lastMessageAt(sort: Desc), id])
  @@index([organizationId, mode, ownerMemberId, lastMessageAt(sort: Desc), id])
  @@index([organizationId, leaseExpiresAt])
  @@map("conversations")
}

model Message {
  id                  String            @id @default(uuid()) @db.Uuid
  organizationId      String            @map("organization_id") @db.Uuid
  conversationId      String            @map("conversation_id") @db.Uuid
  channelConnectionId String            @map("channel_connection_id") @db.Uuid
  direction           String
  origin              String
  providerMessageId   String?           @map("provider_message_id")
  ingressSequence     Int?              @map("ingress_sequence")
  timelineSequence    Int               @map("timeline_sequence")
  lateFlag            Boolean           @default(false) @map("late_flag")
  contentType         String            @default("text") @map("content_type")
  contentText         String            @map("content_text")
  contentDigest       String            @map("content_digest")
  providerEventAt     DateTime?         @map("provider_event_at") @db.Timestamptz(6)
  receivedAt          DateTime          @default(now()) @map("received_at") @db.Timestamptz(6)
  deliveryState       String            @default("ACCEPTED") @map("delivery_state")
  /// Conversation ownership_epoch at outbound create; AI dispatch requires match.
  authorityEpoch      Int?              @map("authority_epoch")
  sendMode            String            @default("FREE_FORM") @map("send_mode")
  templateVersionId   String?           @map("template_version_id") @db.Uuid
  templateParamsJson  Json?             @map("template_params_json")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  organization        Organization      @relation(fields: [organizationId], references: [id])
  conversation        Conversation      @relation(fields: [organizationId, conversationId], references: [organizationId, id])
  channelConnection   ChannelConnection @relation(fields: [organizationId, channelConnectionId], references: [organizationId, id])
  templateVersion     MessageTemplateVersion? @relation(fields: [organizationId, templateVersionId], references: [organizationId, id])
  outboundAttempts    OutboundAttempt[]
  sourceLeads         Lead[]            @relation("LeadSourceMessage")
  sourceBookings      Booking[]         @relation("BookingSourceMessage")
  followUpOutbound    FollowUp[]        @relation("FollowUpOutboundMessage")

  @@unique([organizationId, id])
  @@unique([conversationId, timelineSequence])
  @@index([organizationId, conversationId, timelineSequence, id])
  @@map("messages")
}

model WebhookReceipt {
  id                  String            @id @default(uuid()) @db.Uuid
  organizationId      String            @map("organization_id") @db.Uuid
  channelConnectionId String            @map("channel_connection_id") @db.Uuid
  eventIdentity       String            @map("event_identity")
  payloadDigest       String            @map("payload_digest")
  status              String            @default("ACCEPTED")
  messageId           String?           @map("message_id") @db.Uuid
  receivedAt          DateTime          @default(now()) @map("received_at") @db.Timestamptz(6)
  organization        Organization      @relation(fields: [organizationId], references: [id])
  channelConnection   ChannelConnection @relation(fields: [organizationId, channelConnectionId], references: [organizationId, id])

  @@unique([channelConnectionId, eventIdentity])
  @@unique([organizationId, id])
  @@index([organizationId, receivedAt])
  @@map("webhook_receipts")
}

model OrganizationMember {
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           String
  status         String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  assignedLeads       Lead[]         @relation("LeadAssignee")
  assignedByLeads     Lead[]         @relation("LeadAssigner")
  ownedConversations  Conversation[] @relation("ConversationOwner")

  @@id([organizationId, userId])
  @@index([organizationId, role, status])
  @@map("organization_members")
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  action         String
  targetType     String?       @map("target_type")
  targetId       String?       @map("target_id")
  metadataJson   Json?         @map("metadata_json")
  requestId      String?       @map("request_id")
  recordedAt     DateTime      @default(now()) @map("recorded_at") @db.Timestamptz(6)
  organization   Organization? @relation(fields: [organizationId], references: [id])
  actor          User?         @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([organizationId, recordedAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id                  String             @id @db.Uuid
  organizationId      String             @map("organization_id") @db.Uuid
  eventType           String             @map("event_type")
  payloadJson         Json               @map("payload_json")
  publicationStatus   String             @default("PENDING") @map("publication_status")
  publicationAttempts Int                @default(0) @map("publication_attempts")
  availableAt         DateTime           @default(now()) @map("available_at") @db.Timestamptz(6)
  claimedUntil        DateTime?          @map("claimed_until") @db.Timestamptz(6)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  organization        Organization       @relation(fields: [organizationId], references: [id])
  consumerReceipts    ConsumerReceipt[]

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@map("outbox_events")
}

model ConsumerReceipt {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  consumerName   String      @map("consumer_name")
  eventId        String      @map("event_id") @db.Uuid
  appliedAt      DateTime    @default(now()) @map("applied_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id])
  outboxEvent    OutboxEvent @relation(fields: [organizationId, eventId], references: [organizationId, id])

  @@unique([consumerName, eventId])
  @@unique([organizationId, id])
  @@map("consumer_receipts")
}

model OutboundAttempt {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  messageId         String       @map("message_id") @db.Uuid
  attemptNumber     Int          @map("attempt_number")
  ownershipEpoch    Int          @map("ownership_epoch")
  status            String       @default("PENDING")
  providerMessageId String?      @map("provider_message_id")
  errorText         String?      @map("error_text")
  dispatchedAt      DateTime?    @map("dispatched_at") @db.Timestamptz(6)
  acceptedAt        DateTime?    @map("accepted_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization      Organization @relation(fields: [organizationId], references: [id])
  message           Message      @relation(fields: [organizationId, messageId], references: [organizationId, id])

  @@unique([messageId, attemptNumber])
  @@unique([organizationId, id])
  @@map("outbound_attempts")
}

/// Durable idempotency for commands that must survive retries (e.g. org create).
model IdempotencyRecord {
  id             String    @id @default(uuid()) @db.Uuid
  actorUserId    String    @map("actor_user_id") @db.Uuid
  operation      String
  idempotencyKey String    @map("idempotency_key")
  requestHash    String    @map("request_hash")
  status         String
  responseJson   Json?     @map("response_json")
  organizationId String?   @map("organization_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  actor          User      @relation(fields: [actorUserId], references: [id])

  @@unique([actorUserId, operation, idempotencyKey])
  @@map("idempotency_records")
}

model AgentConfig {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  version        Int
  status         String     @default("DRAFT")
  promptVersion  String     @map("prompt_version")
  modelProfile   String     @map("model_profile")
  toolAllowlist  Json       @map("tool_allowlist")
  budgetsJson    Json       @map("budgets_json")
  localeDefault  String?    @map("locale_default")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  activatedAt    DateTime?  @map("activated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id])
  agentRuns      AgentRun[]

  @@unique([organizationId, version])
  @@unique([organizationId, id])
  @@map("agent_configs")
}

model AgentRun {
  id                     String        @id @default(uuid()) @db.Uuid
  organizationId         String        @map("organization_id") @db.Uuid
  conversationId         String        @map("conversation_id") @db.Uuid
  runKey                 String        @map("run_key")
  targetIngressSequence  Int           @map("target_ingress_sequence")
  ownershipEpoch         Int           @map("ownership_epoch")
  leaseFence             Int           @map("lease_fence")
  agentConfigId          String        @map("agent_config_id") @db.Uuid
  promptVersion          String        @map("prompt_version")
  modelProfile           String        @map("model_profile")
  status                 String        @default("RUNNING")
  terminalReason         String?       @map("terminal_reason")
  modelCalls             Int           @default(0) @map("model_calls")
  toolCalls              Int           @default(0) @map("tool_calls")
  finalOutboundMessageId String?       @unique @map("final_outbound_message_id") @db.Uuid
  startedAt              DateTime      @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt             DateTime?     @map("finished_at") @db.Timestamptz(6)
  organization           Organization  @relation(fields: [organizationId], references: [id])
  conversation           Conversation  @relation(fields: [organizationId, conversationId], references: [organizationId, id])
  agentConfig            AgentConfig   @relation(fields: [organizationId, agentConfigId], references: [organizationId, id])
  toolCallRows           ToolCall[]
  commandOperations      CommandOperation[]
  usageEvents            UsageEvent[]
  createdLeads           Lead[]          @relation("LeadCreatedByAgentRun")
  leadActivities         LeadActivity[]  @relation("LeadActivitySourceAgentRun")
  createdBookings        Booking[]       @relation("BookingCreatedByAgentRun")
  createdFollowUps       FollowUp[]      @relation("FollowUpCreatedByAgentRun")

  @@unique([organizationId, runKey])
  @@unique([organizationId, id])
  @@index([organizationId, conversationId, startedAt])
  @@map("agent_runs")
}

model ToolCall {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  agentRunId     String       @map("agent_run_id") @db.Uuid
  ordinal        Int
  toolName       String       @map("tool_name")
  toolVersion    String       @map("tool_version")
  argsHash       String       @map("args_hash")
  authzResult    String       @map("authz_result")
  operationId    String?      @map("operation_id") @db.Uuid
  resultCode     String       @map("result_code")
  durationMs     Int          @map("duration_ms")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id])
  agentRun       AgentRun     @relation(fields: [organizationId, agentRunId], references: [organizationId, id])

  @@unique([agentRunId, ordinal])
  @@unique([organizationId, id])
  @@map("tool_calls")
}

model CommandOperation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  operationKey   String       @map("operation_key")
  agentRunId     String       @map("agent_run_id") @db.Uuid
  status         String       @default("IN_PROGRESS")
  resultJson     Json?        @map("result_json")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id])
  agentRun       AgentRun     @relation(fields: [organizationId, agentRunId], references: [organizationId, id])

  @@unique([organizationId, operationKey])
  @@unique([organizationId, id])
  @@map("command_operations")
}

model UsageEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  agentRunId     String       @map("agent_run_id") @db.Uuid
  provider       String
  model          String
  inputTokens    Int?         @map("input_tokens")
  outputTokens   Int?         @map("output_tokens")
  estimated      Boolean      @default(true)
  latencyMs      Int          @map("latency_ms")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id])
  agentRun       AgentRun     @relation(fields: [organizationId, agentRunId], references: [organizationId, id])

  @@unique([organizationId, id])
  @@index([organizationId, agentRunId])
  @@map("usage_events")
}

model ConversationSummary {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
