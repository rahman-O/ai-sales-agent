  statusReasonText      String?             @map("status_reason_text")
  statusChangedAt       DateTime            @default(now()) @map("status_changed_at") @db.Timestamptz(6)
  statusChangedByType   String?             @map("status_changed_by_type")
  statusChangedById     String?             @map("status_changed_by_id") @db.Uuid
  version               Int                 @default(1)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt            DateTime?           @map("archived_at") @db.Timestamptz(6)
  organization          Organization        @relation(fields: [organizationId], references: [id])
  customer              Customer            @relation(fields: [organizationId, customerId], references: [organizationId, id])
  primaryService        Service?            @relation(fields: [organizationId, primaryServiceId], references: [organizationId, id])
  location              Location?           @relation(fields: [organizationId, locationId], references: [organizationId, id])
  assignee              OrganizationMember? @relation("LeadAssignee", fields: [organizationId, assignedUserId], references: [organizationId, userId])
  assigner              OrganizationMember? @relation("LeadAssigner", fields: [organizationId, assignedByUserId], references: [organizationId, userId])
  sourceConversation    Conversation?       @relation("LeadSourceConversation", fields: [organizationId, sourceConversationId], references: [organizationId, id])
