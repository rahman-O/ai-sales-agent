{
  "name": "@ai-sales-agent/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "test:integration": "node --import tsx --test test/integration/**/*.test.ts"
  },
  "dependencies": {
    "@ai-sales-agent/agent-adapters": "*",
    "@ai-sales-agent/agent-core": "*",
    "@ai-sales-agent/config": "*",
    "@ai-sales-agent/contracts": "*",
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "jose": "6.1.0",
    "pg": "8.16.3",
    "redis": "5.8.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.5.2",
    "@types/pg": "8.15.5",
    "typescript": "5.9.2"
  }
}
