# Copy to .env.demo.local (gitignored) and fill real local values.
# Never commit .env.demo.local. Used by: docker compose -f docker-compose.demo.yml

# --- Postgres (local demo volume only) ---
POSTGRES_DB=ai_sales_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-demo-postgres-password
APP_RUNTIME_DB_PASSWORD=change-me-demo-runtime-password

# --- App secrets (local only) ---
BOOKING_SLOT_TOKEN_SECRET=change-me-demo-booking-slot-token-secret

# --- Hosted Auth (JWKS / login only — publishable keys, no service role) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Optional TEI image override (arm64):
# TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-1.9
