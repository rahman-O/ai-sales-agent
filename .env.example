# Local development — fake values only. Never commit real secrets.

# Prefer real secrets in `.env.local` (gitignored). Never paste passwords into chat.



NODE_ENV=development



# Application

APP_URL=http://localhost:3000

API_URL=http://localhost:3001



# Runtime DB role (NestJS / integration tests) — app_runtime, NOBYPASSRLS

# After migrate, run: WRITE_DATABASE_URL_FROM_MIGRATION_HOST=true npm run db:provision-runtime-role

DATABASE_URL=postgresql://app_runtime:p01_runtime_only@127.0.0.1:5433/ai_sales_agent



# Migration owner only (Prisma CLI). Never inject into NestJS.

MIGRATION_DATABASE_URL=postgresql://postgres:p01_migrate_only@127.0.0.1:5433/ai_sales_agent



# Optional Prisma migrate shadow DB

# SHADOW_DATABASE_URL=postgresql://postgres:p01_migrate_only@127.0.0.1:5433/ai_sales_agent_shadow



# Runtime role password (local/hosted). Used by db:provision-runtime-role — never put in migrations.

APP_RUNTIME_DB_PASSWORD=p01_runtime_only



# Hosted Connect pieces (optional; copy literally from Supabase Connect — do not invent pooler hosts)

# APP_RUNTIME_DB_USER=app_runtime.<project-ref>

# APP_RUNTIME_DB_HOST=

# APP_RUNTIME_DB_PORT=6543

# APP_RUNTIME_DB_NAME=postgres

# APP_RUNTIME_DB_PARAMS=sslmode=require



REDIS_URL=redis://127.0.0.1:6379



# Supabase Auth (publishable / public — browser-safe)

NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example_not_real



# Server-side Supabase project URL (JWKS derived as {SUPABASE_URL}/auth/v1/.well-known/jwks.json)

SUPABASE_URL=https://example.supabase.co



# Optional legacy HS256 fallback for local architecture tests only — never default for hosted acceptance; never expose to browser

# SUPABASE_JWT_SECRET=local-test-hs256-secret-not-for-prod



# Synthetic Auth user for hosted acceptance (never commit real values; never use customer/clinic data)
# SUPABASE_TEST_EMAIL=phase01-test@example.com
# SUPABASE_TEST_PASSWORD=

# DEVELOPMENT/TEST only — Admin Auth API key for `npm run auth:provision-test-user`
# NEVER put in NEXT_PUBLIC_*, Nest runtime, browser, CI, or docs. Safe to remove from .env.local after provisioning.
# SUPABASE_TEST_ADMIN_KEY=

# Test / seed guards
ALLOW_DB_SEED=true

